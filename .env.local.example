# Copy this file to .env.local and fill in real values.

# Pixellab (or whichever real image-generation backend replaces MockGenerator)
# PIXELLAB_API_KEY=

# Anthropic (enables real website theme generation, replacing MockThemeGenerator)
# ANTHROPIC_API_KEY=

# Alternative Claude API provider for theme generation — set THEME_API_PROVIDER
# to switch away from the official Anthropic API above. Leave unset to use
# ANTHROPIC_API_KEY above (or MockThemeGenerator if that's unset too).
# THEME_API_PROVIDER=cheaperinference
# CHEAPERINFERENCE_API_KEY=

# Google Drive (enables the Drive file manager and Share to Drive). See the
# README's "Google Drive setup" section for the Google Cloud Console steps.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Base URL this app is reachable at — used to build the Google Drive OAuth
# redirect URI. Defaults to http://localhost:3000 if unset.
# APP_BASE_URL=

# Worker: how many pending jobs it claims per poll tick.
WORKER_BATCH_SIZE=5

# Shared IO batching size for chunked file operations (git staging,
# orphaned-image cleanup).
IO_WRITE_BATCH_SIZE=25
