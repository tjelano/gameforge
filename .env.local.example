# Copy this file to .env.local and fill in real values.

# Pixellab (or whichever real image-generation backend replaces MockGenerator)
# PIXELLAB_API_KEY=

# Worker: how many pending jobs it claims per poll tick.
WORKER_BATCH_SIZE=5

# Shared IO batching size for chunked file operations (git staging,
# orphaned-image cleanup).
IO_WRITE_BATCH_SIZE=25
