#!/bin/sh
# Mirrors CI's three required gates (.github/workflows/ci.yml: Typecheck,
# Lint, Test) so a broken push gets caught here instead of after CI runs.
# This has been skipped by hand before (see AGENTS.md's "Start here" #5) --
# a hook that runs automatically on every push closes that gap instead of
# relying on remembering to run it.
#
# One-time setup after cloning: git config core.hooksPath .githooks

set -e

echo "pre-push: npx tsc --noEmit"
npx tsc --noEmit

echo "pre-push: npx eslint app lib worker.ts"
# Not `npm run lint` (bare `eslint .`) -- on this machine that also sweeps
# .claude/worktrees/ (sibling worktrees) and .next build output, neither of
# which eslint.config.mjs ignores, producing thousands of irrelevant hits.
npx eslint app lib worker.ts

echo "pre-push: npx vitest run"
npx vitest run
